generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum para definir os papéis de usuário.
// Isso garante que o campo 'tipo' só possa ter os valores 'CLIENTE' ou 'PRESTADOR'.
enum StatusServico {
  PENDENTE_CONFIRMACAO_CLIENTE
  CONCLUIDO
  RECUSADO
}


model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String // Iremos armazenar a senha criptografada aqui
  telefone  String
  is_prestador Boolean @default(false)
  // Campos de endereço, como você sugeriu.
  // O '?' torna o campo opcional.
  cep         String // Tornamos o CEP obrigatório
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  latitude    Float?
  longitude   Float?

  foto_perfil_url String?
  aprovado        Boolean  @default(false) // MODERAÇÃO: Usuário precisa ser aprovado.
  data_criacao    DateTime @default(now())

  // --- CAMPOS DE GAMIFICAÇÃO ---
  nivel_cliente   String   @default("Bronze")
  nivel_prestador String   @default("Bronze")

  // --- CAMPOS PARA PERFIL PÚBLICO DO PRESTADOR ---
  titulo_profissional String?
  biografia           String?     @db.Text // Usar @db.Text para textos longos é uma boa prática
  anos_experiencia    Int?
  links_redes_sociais String[]

  // --- RELACIONAMENTOS ---
  // Um usuário (prestador) pode ter vários serviços oferecidos.
  servicos_oferecidos Servico[]   @relation("PrestadorServicos")

  // Um usuário (prestador) pode receber várias avaliações.
  avaliacoes_recebidas Avaliacao[] @relation("PrestadorAvaliado")

  // Um usuário (cliente) pode fazer várias avaliações.
  avaliacoes_feitas    Avaliacao[] @relation("ClienteAvaliador")

  // Um usuário pode solicitar vários registros de serviço (como prestador)
  servicos_solicitados RegistroServico[] @relation("PrestadorSolicitante")

  // Um usuário pode receber várias solicitações de serviço (como cliente)
  servicos_recebidos   RegistroServico[] @relation("ClienteAlvo")

  @@map("usuarios") // Mapeia este modelo para a tabela "usuarios" no banco de dados.
}

model Servico {
  id        Int      @id @default(autoincrement())
  titulo    String
  descricao String   @db.Text
  categoria String
  preco     Decimal? @db.Decimal(10, 2) // Define precisão para valores monetários
  imagens   String[] // Mantendo a estrutura de array, como solicitado.
  aprovado  Boolean  @default(false) // MODERAÇÃO: Serviço precisa ser aprovado.

  data_criacao     DateTime @default(now())
  data_atualizacao DateTime @updatedAt

  // Relacionamento: Este serviço pertence a um prestador.
  prestador   Usuario @relation("PrestadorServicos", fields: [prestadorId], references: [id], onDelete: Cascade)
  prestadorId Int

  @@map("servicos")
}

model Avaliacao {
  id           Int      @id @default(autoincrement())
  nota         Int // Ex: 1 a 5
  comentario   String?  @db.Text
  aprovada     Boolean  @default(false) // MODERAÇÃO: Avaliação precisa ser aprovada.
  data_criacao DateTime @default(now())

  // Relacionamento: A avaliação é sobre um prestador.
  prestador   Usuario @relation("PrestadorAvaliado", fields: [prestadorId], references: [id])
  prestadorId Int

  // Relacionamento: A avaliação foi feita por um cliente.
  cliente   Usuario @relation("ClienteAvaliador", fields: [clienteId], references: [id])
  clienteId Int

  // Relacionamento opcional com RegistroServico (para o futuro)
  registro   RegistroServico? @relation(fields: [registroId], references: [id])
  registroId Int?             @unique

  @@map("avaliacoes")
}

model RegistroServico {
  id     Int           @id @default(autoincrement())
  status StatusServico @default(PENDENTE_CONFIRMACAO_CLIENTE)

  // Relacionamento com o Prestador que solicitou a confirmação
  prestador   Usuario @relation("PrestadorSolicitante", fields: [prestadorId], references: [id])
  prestadorId Int

  // Relacionamento com o Cliente que precisa confirmar
  cliente   Usuario @relation("ClienteAlvo", fields: [clienteId], references: [id])
  clienteId Int

  // Um registro de serviço pode ter uma avaliação associada
  avaliacao Avaliacao?

  @@map("registros_servicos")
}